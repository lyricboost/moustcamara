[
    {
        "key": "group_contact_form",
        "title": "Contact Form Settings",
        "fields": [
            {
                "key": "field_contact_heading",
                "label": "Heading",
                "name": "heading",
                "type": "text",
                "instructions": "Main heading for the form section",
                "required": 0,
                "default_value": "Get in Touch",
                "placeholder": "Contact Us"
            },
            {
                "key": "field_contact_description",
                "label": "Description",
                "name": "description",
                "type": "textarea",
                "instructions": "Optional description text below heading",
                "required": 0,
                "rows": 3,
                "placeholder": "We'd love to hear from you..."
            },
            {
                "key": "field_contact_bg_color",
                "label": "Background Color",
                "name": "background_color",
                "type": "select",
                "instructions": "Select background color",
                "required": 0,
                "choices": {
                    "white": "White",
                    "light-gray": "Light Gray",
                    "medium-gray": "Medium Gray",
                    "dark-gray": "Dark Gray",
                    "navy": "Navy",
                    "black": "Black"
                },
                "default_value": "white",
                "allow_null": 0,
                "multiple": 0
            },
            {
                "key": "field_contact_fields",
                "label": "Form Fields",
                "name": "form_fields",
                "type": "repeater",
                "instructions": "Add and configure form fields",
                "required": 1,
                "layout": "block",
                "button_label": "Add Field",
                "sub_fields": [
                    {
                        "key": "field_contact_field_type",
                        "label": "Field Type",
                        "name": "field_type",
                        "type": "select",
                        "instructions": "Type of form field",
                        "required": 1,
                        "choices": {
                            "text": "Text Input",
                            "email": "Email Input",
                            "textarea": "Text Area",
                            "select": "Dropdown Select",
                            "radio": "Radio Buttons",
                            "checkbox": "Checkboxes"
                        },
                        "default_value": "text",
                        "allow_null": 0
                    },
                    {
                        "key": "field_contact_label",
                        "label": "Label",
                        "name": "label",
                        "type": "text",
                        "instructions": "Field label (also used as field name)",
                        "required": 1,
                        "placeholder": "Full Name"
                    },
                    {
                        "key": "field_contact_placeholder",
                        "label": "Placeholder",
                        "name": "placeholder",
                        "type": "text",
                        "instructions": "Placeholder text (for text/email/textarea only)",
                        "required": 0,
                        "placeholder": "Enter your name..."
                    },
                    {
                        "key": "field_contact_required",
                        "label": "Required",
                        "name": "required",
                        "type": "true_false",
                        "instructions": "Make this field required",
                        "required": 0,
                        "default_value": 0,
                        "ui": 1
                    },
                    {
                        "key": "field_contact_options",
                        "label": "Options",
                        "name": "options",
                        "type": "textarea",
                        "instructions": "Options for select/radio/checkbox (one per line)",
                        "required": 0,
                        "rows": 4,
                        "placeholder": "Option 1\nOption 2\nOption 3",
                        "conditional_logic": [
                            [
                                {
                                    "field": "field_contact_field_type",
                                    "operator": "==",
                                    "value": "select"
                                }
                            ],
                            [
                                {
                                    "field": "field_contact_field_type",
                                    "operator": "==",
                                    "value": "radio"
                                }
                            ],
                            [
                                {
                                    "field": "field_contact_field_type",
                                    "operator": "==",
                                    "value": "checkbox"
                                }
                            ]
                        ]
                    }
                ]
            },
            {
                "key": "field_contact_submit_text",
                "label": "Submit Button Text",
                "name": "submit_text",
                "type": "text",
                "instructions": "Text for the submit button",
                "required": 0,
                "default_value": "Send Message",
                "placeholder": "Submit"
            },
            {
                "key": "field_contact_recipient",
                "label": "Recipient Email",
                "name": "recipient_email",
                "type": "email",
                "instructions": "Where to send form submissions (defaults to site admin email)",
                "required": 0,
                "placeholder": "your@email.com"
            },
            {
                "key": "field_contact_success_message",
                "label": "Success Message",
                "name": "success_message",
                "type": "text",
                "instructions": "Message shown after successful submission",
                "required": 0,
                "default_value": "Thank you! Your message has been sent.",
                "placeholder": "Thank you for contacting us!"
            }
        ],
        "location": [
            [
                {
                    "param": "block",
                    "operator": "==",
                    "value": "acf/contact-form"
                }
            ]
        ],
        "menu_order": 0,
        "position": "normal",
        "style": "default",
        "label_placement": "top",
        "instruction_placement": "label",
        "hide_on_screen": "",
        "active": true,
        "description": ""
    }
]
