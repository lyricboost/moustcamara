{
  "key": "group_moust_faq",
  "title": "Moust FAQ Block",
  "fields": [
    {
      "key": "field_faq_heading",
      "label": "Heading",
      "name": "heading",
      "type": "text",
      "required": 0
    },
    {
      "key": "field_faq_heading_size",
      "label": "Heading Size",
      "name": "heading_size",
      "type": "select",
      "choices": {
        "large": "Large",
        "medium": "Medium"
      },
      "default_value": "large",
      "required": 0
    },
    {
      "key": "field_faq_subheading",
      "label": "Subheading",
      "name": "subheading",
      "type": "textarea",
      "rows": 3,
      "required": 0
    },
    {
      "key": "field_faq_intro_text",
      "label": "Intro Text",
      "name": "intro_text",
      "type": "wysiwyg",
      "tabs": "visual",
      "toolbar": "basic",
      "media_upload": 0,
      "required": 0,
      "instructions": "Optional introductory text before the FAQ items"
    },
    {
      "key": "field_faq_image",
      "label": "Image",
      "name": "image",
      "type": "image",
      "return_format": "array",
      "preview_size": "medium",
      "library": "all",
      "required": 0,
      "instructions": "Optional image shown on desktop (left side)"
    },
    {
      "key": "field_faq_show_numbering",
      "label": "Show Numbering",
      "name": "show_numbering",
      "type": "true_false",
      "default_value": 0,
      "ui": 1,
      "instructions": "Display numbered questions (01, 02, etc.)"
    },
    {
      "key": "field_faq_items",
      "label": "FAQ Items",
      "name": "items",
      "type": "repeater",
      "required": 0,
      "layout": "block",
      "button_label": "Add Question",
      "sub_fields": [
        {
          "key": "field_faq_item_question",
          "label": "Question",
          "name": "question",
          "type": "text",
          "required": 1
        },
        {
          "key": "field_faq_item_answer",
          "label": "Answer",
          "name": "answer",
          "type": "wysiwyg",
          "tabs": "visual",
          "toolbar": "basic",
          "media_upload": 0,
          "required": 0
        }
      ]
    },
    {
      "key": "field_faq_background_color",
      "label": "Background Color",
      "name": "background_color",
      "type": "select",
      "choices": {
        "none": "None (Transparent)",
        "light-gray": "Light Gray",
        "medium-gray": "Medium Gray",
        "navy": "Navy",
        "dark-gray": "Dark Gray",
        "black": "Black"
      },
      "default_value": "none",
      "required": 0
    }
  ],
  "location": [
    [
      {
        "param": "block",
        "operator": "==",
        "value": "acf/faq"
      }
    ]
  ]
}
