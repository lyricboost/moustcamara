[
    {
        "key": "group_testimonials",
        "title": "Testimonials Settings",
        "fields": [
            {
                "key": "field_testimonials_heading",
                "label": "Heading",
                "name": "heading",
                "type": "text",
                "instructions": "Optional heading above testimonials",
                "required": 0,
                "placeholder": "What Our Clients Say"
            },
            {
                "key": "field_testimonials_format",
                "label": "Format",
                "name": "format",
                "type": "select",
                "instructions": "Display testimonials as carousel or grid",
                "required": 1,
                "choices": {
                    "carousel": "Carousel",
                    "grid": "Grid"
                },
                "default_value": "carousel",
                "allow_null": 0
            },
            {
                "key": "field_testimonials_items_per_row",
                "label": "Items Per Row",
                "name": "items_per_row",
                "type": "select",
                "instructions": "Number of testimonials per row (grid format only)",
                "required": 0,
                "choices": {
                    "1": "1 Column",
                    "2": "2 Columns",
                    "3": "3 Columns"
                },
                "default_value": "3",
                "conditional_logic": [
                    [
                        {
                            "field": "field_testimonials_format",
                            "operator": "==",
                            "value": "grid"
                        }
                    ]
                ]
            },
            {
                "key": "field_testimonials_items_per_carousel",
                "label": "Items Per Carousel Page",
                "name": "items_per_carousel",
                "type": "select",
                "instructions": "Number of testimonials visible at once (carousel format only)",
                "required": 0,
                "choices": {
                    "1": "1 Item",
                    "2": "2 Items",
                    "3": "3 Items"
                },
                "default_value": "1",
                "conditional_logic": [
                    [
                        {
                            "field": "field_testimonials_format",
                            "operator": "==",
                            "value": "carousel"
                        }
                    ]
                ]
            },
            {
                "key": "field_testimonials_bg_color",
                "label": "Background Color",
                "name": "background_color",
                "type": "select",
                "instructions": "Select background color",
                "required": 0,
                "choices": {
                    "white": "White",
                    "light-gray": "Light Gray",
                    "medium-gray": "Medium Gray",
                    "dark-gray": "Dark Gray",
                    "navy": "Navy",
                    "black": "Black"
                },
                "default_value": "white",
                "allow_null": 0
            },
            {
                "key": "field_testimonials_items",
                "label": "Testimonials",
                "name": "testimonials",
                "type": "repeater",
                "instructions": "Add testimonials",
                "required": 1,
                "layout": "block",
                "button_label": "Add Testimonial",
                "sub_fields": [
                    {
                        "key": "field_testimonial_text",
                        "label": "Testimonial Text",
                        "name": "testimonial_text",
                        "type": "textarea",
                        "instructions": "The testimonial quote",
                        "required": 1,
                        "rows": 4
                    },
                    {
                        "key": "field_testimonial_image",
                        "label": "Image",
                        "name": "image",
                        "type": "image",
                        "instructions": "Headshot or logo",
                        "required": 0,
                        "return_format": "array",
                        "preview_size": "thumbnail",
                        "library": "all"
                    },
                    {
                        "key": "field_testimonial_name",
                        "label": "Name",
                        "name": "name",
                        "type": "text",
                        "instructions": "Person's name",
                        "required": 1,
                        "placeholder": "John Doe"
                    },
                    {
                        "key": "field_testimonial_byline",
                        "label": "Byline",
                        "name": "byline",
                        "type": "text",
                        "instructions": "Title and/or company",
                        "required": 0,
                        "placeholder": "CEO, Company Name"
                    }
                ]
            }
        ],
        "location": [
            [
                {
                    "param": "block",
                    "operator": "==",
                    "value": "acf/testimonials"
                }
            ]
        ],
        "menu_order": 0,
        "position": "normal",
        "style": "default",
        "label_placement": "top",
        "instruction_placement": "label",
        "active": true
    }
]
