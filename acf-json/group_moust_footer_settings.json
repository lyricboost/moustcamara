        {
            "key": "field_footer_menus_notice",
            "label": "",
            "name": "",
            "type": "message",
            "message": "Footer link columns and the bottom row links are managed through the native WordPress menu system: go to Appearance > Menus and assign menus to the \"Footer Column 1\", \"Footer Column 2\", \"Footer Column 3\", and \"Footer Bottom Row\" locations. Relative links like \/work are supported there. External links automatically open in a new tab and show an arrow indicator.",
            "new_lines": "wpautop",
            "esc_html": 0
        },
        {
            "key": "field_footer_bottom_tab",
