            "default_value": "Moust Camara",
            "wrapper": { "width": "50", "class": "", "id": "" }
        },
        {
            "key": "field_footer_logo",
            "label": "Logo (Optional)",
            "name": "footer_logo",
            "type": "image",
            "instructions": "White\/light version recommended. Displayed at ~2rem height.",
            "return_format": "array",
            "library": "all",
            "preview_size": "medium",
            "mime_types": "png,svg,webp",
            "wrapper": { "width": "50", "class": "", "id": "" }
        },
        {
            "key": "field_footer_newsletter_tab",
            "label": "Newsletter",
            "name": "",
            "type": "tab",
            "placement": "top"
        },
        {
            "key": "field_footer_newsletter_enable",
            "label": "Show Newsletter Signup",
            "name": "footer_newsletter_enable",
            "type": "true_false",
            "default_value": 1,
            "ui": 1,
            "wrapper": { "width": "50", "class": "", "id": "" }
        },
        {
            "key": "field_footer_newsletter_heading",
            "label": "Newsletter Heading",
            "name": "footer_newsletter_heading",
            "type": "text",
            "instructions": "Bold heading above the signup form (body text size, weight 600)",
            "default_value": "Camara Lens Newsletter",
            "conditional_logic": [[{ "field": "field_footer_newsletter_enable", "operator": "==", "value": "1" }]],
            "wrapper": { "width": "50", "class": "", "id": "" }
        },
        {
            "key": "field_footer_newsletter_text",
            "label": "Newsletter Text",
            "name": "footer_newsletter_text",
            "type": "text",
