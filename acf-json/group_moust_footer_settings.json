                        "instagram": "Instagram",
                        "twitter": "X \/ Twitter",
                        "facebook": "Facebook",
                        "github": "GitHub",
                        "music": "TikTok \/ Music",
                        "mail": "Email",
                        "globe": "Website",
                        "rss": "RSS"
