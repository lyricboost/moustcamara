            "wrapper": { "width": "50", "class": "", "id": "" }
        },
        {
            "key": "field_footer_newsletter_placeholder",
            "label": "Email Placeholder",
            "name": "footer_newsletter_placeholder",
            "type": "text",
            "default_value": "Your email address",
            "conditional_logic": [[{ "field": "field_footer_newsletter_enable", "operator": "==", "value": "1" }]],
            "wrapper": { "width": "33", "class": "", "id": "" }
        },
        {
            "key": "field_footer_newsletter_button_text",
            "label": "Button Text",
            "name": "footer_newsletter_button_text",
            "type": "text",
            "default_value": "Subscribe",
            "conditional_logic": [[{ "field": "field_footer_newsletter_enable", "operator": "==", "value": "1" }]],
            "wrapper": { "width": "33", "class": "", "id": "" }
        },
        {
            "key": "field_footer_newsletter_list_id",
            "label": "Mailchimp List ID",
            "name": "footer_newsletter_list_id",
            "type": "text",
            "conditional_logic": [[{ "field": "field_footer_newsletter_enable", "operator": "==", "value": "1" }]],
            "wrapper": { "width": "34", "class": "", "id": "" }
        },
        {
            "key": "field_footer_newsletter_api_key",
            "label": "Mailchimp API Key",
            "name": "footer_newsletter_api_key",
            "type": "text",
            "conditional_logic": [[{ "field": "field_footer_newsletter_enable", "operator": "==", "value": "1" }]],
            "wrapper": { "width": "50", "class": "", "id": "" }
        },
        {
